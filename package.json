{
  "name": "compilerviz",
  "displayName": "CompilerViz",
  "description": "Animate the AST and three-address code built by your own compiler, step by step.",
  "version": "0.0.1",
  "publisher": "your-name",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Education", "Visualization"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "compilerviz.run", "title": "CompilerViz: Run Compiler and Visualize" }
    ],
    "configuration": {
      "title": "CompilerViz",
      "properties": {
        "compilerviz.command": {
          "type": "string",
          "default": "",
          "description": "Command that runs your compiler. Use ${file} for the active file, e.g. ./minilang ${file}"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
